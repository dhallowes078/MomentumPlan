# Copy to apps/web/.env

NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Development-only login that does not require Microsoft.
AUTH_ALLOW_LOCAL_LOGIN=false

# Local default (SQLite — no Docker needed)
DATABASE_URL="file:./dev.db"

# Optional Postgres (docker compose):
# DATABASE_URL=postgresql://momentum:momentum@localhost:5432/momentum?schema=public
# (requires changing prisma datasource provider to postgresql)

# Microsoft Entra ID — multi-tenant app registration
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Optional Google sign-in (web + Workers)
# Redirect URI (prod): https://momentum.momentum-app.workers.dev/api/auth/callback/google
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional S3/MinIO attachments (omit to use local ./uploads)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=momentum
# S3_SECRET_KEY=momentumsecret
# S3_BUCKET=momentum-attachments
# S3_FORCE_PATH_STYLE=true

# Cloudflare Workers (OpenNext) — set after `wrangler login` + D1/R2 setup
# AUTH_URL=https://your-worker.workers.dev
# NEXT_PUBLIC_APP_URL=https://your-worker.workers.dev
